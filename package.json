{
  "name": "request-dot-js",
  "version": "3.2.4",
  "author": "Kyle Bebak <kylebebak@gmail.com>",
  "description": "A ~1kB fetch wrapper with convenient error handling, automatic JSON transforms, and support for exponential backoff.",
  "keywords": [
    "fetch",
    "request",
    "JSON",
    "backoff",
    "retry"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/fortana-co/request.js.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^12.0.8",
    "abort-controller": "^3.0.0",
    "ava": "^1.2.1",
    "node-fetch": "^2.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^3.5.1"
  },
  "scripts": {
    "prepare-browser": "node prepareBrowser.js && oxfmt index.ts",
    "build": "npm test",
    "test": "npm run prepare-browser && tsc && npm run format-check && npm run lint && ava -v",
    "format-check": "oxfmt --check *.ts",
    "format": "oxfmt *.ts",
    "lint": "oxlint *.ts"
  },
  "dependencies": {}
}
